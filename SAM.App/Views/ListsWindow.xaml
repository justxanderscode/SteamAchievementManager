<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SAM.App.Views.ListsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lists="using:SAM.App.Lists"
    xmlns:loc="using:SAM.App.Localization"
    Title="Steam Achievement Manager">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="48" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/SAM-32.png" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="1" Padding="36,18,36,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="{x:Bind loc:Strings.ListsTitle}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Margin="0,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text=" " TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Padding="10,8" AutomationProperties.Name="{x:Bind loc:Strings.Reload}" ToolTipService.ToolTip="{x:Bind loc:Strings.ReloadTooltip}" Click="OnRefreshClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnExportClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                        <TextBlock Text="{x:Bind loc:Strings.ExportGuide}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="LegendBar"
            Grid.Row="2"
            Margin="36,0,36,12"
            IsClosable="True"
            IsOpen="True"
            Message="{x:Bind loc:Strings.ListsLegend}"
            Severity="Informational"
            Title="{x:Bind loc:Strings.ListsLegendTitle}" />

        <Grid Grid.Row="3">
            <Grid x:Name="ContentGrid" Margin="28,0,36,0" ColumnSpacing="20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Categories -->
                <ListView
                    x:Name="CategoryList"
                    Padding="0,0,0,24"
                    SelectionChanged="OnCategoryChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lists:ListCategory">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,10,0,6"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind GroupCaption}"
                                    Visibility="{x:Bind IsGroupStart}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                        <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind CountText}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Games of the selected category -->
                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="4,6,0,0">
                        <TextBlock x:Name="CategoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="CategoryDescription" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Width="280"
                            PlaceholderText="{x:Bind loc:Strings.ListsSearch}"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" />
                        <Button Click="OnCopyIdsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind loc:Strings.CopyAppIds}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnCopyNamesClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind loc:Strings.CopyNames}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView x:Name="GamesList" Grid.Row="2" Padding="0,0,0,24" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lists:ListGame">
                                <Grid
                                    MinHeight="58"
                                    Padding="14,8,8,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="14"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                            <Border Style="{StaticResource BadgeStyle}" ToolTipService.ToolTip="{x:Bind VisibilityTooltip}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind VisibilityText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind CantFinishReason}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasReason}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind ProgressText}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind PercentText}" />
                                        </Grid>
                                        <ProgressBar Maximum="1" Value="{x:Bind Ratio}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind loc:Strings.MoreOptions}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind loc:Strings.MoreOptions}">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Click="OnOpenGameClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.ManageAchievements}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE735;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnStorePageClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.OpenStorePage}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE719;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="OnMarkCantFinishClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.MarkCantFinish}" Visibility="{x:Bind CanMarkCantFinish}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7BA;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="OnUnmarkCantFinishClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.UnmarkCantFinish}" Visibility="{x:Bind IsCantFinishMarked}" />
                                                <MenuFlyoutItem Click="OnMarkNotAnymoreClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.MarkNotAnymore}" Visibility="{x:Bind CanMarkNotAnymore}" />
                                                <MenuFlyoutItem Click="OnUnmarkNotAnymoreClick" Tag="{x:Bind AppId}" Text="{x:Bind loc:Strings.UnmarkNotAnymore}" Visibility="{x:Bind IsNotAnymore}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyText"
                        Grid.Row="2"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind loc:Strings.ListEmpty}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing Width="44" Height="44" IsActive="True" />
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>

            <!-- Error -->
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" Style="{StaticResource StateGlyphStyle}" />
                <TextBlock x:Name="ErrorTitle" Style="{StaticResource StateTitleStyle}" />
                <TextBlock x:Name="ErrorMessage" Style="{StaticResource StateMessageStyle}" IsTextSelectionEnabled="True" />
                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="{x:Bind loc:Strings.Retry}" Style="{StaticResource AccentButtonStyle}" Click="OnRefreshClick" />
            </StackPanel>

            <InfoBar
                x:Name="NotifyBar"
                MaxWidth="560"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </Grid>
</Window>
